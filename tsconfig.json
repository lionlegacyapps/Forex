{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./api-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@truck-dispatch/shared": ["./shared/src/index.ts"]
    }
  },
  "include": ["api/**/*", "server/src/**/*", "shared/src/**/*"],
  "exclude": ["node_modules", "client", "server/prisma"]
}
