# Application
APP_NAME=algo-trading-backend
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# REQUIRED for database work: paste your Supabase PostgreSQL connection string
# into DATABASE_URL below (repository-root `.env`, never commit this file).
#
# Persistent development database = Supabase PostgreSQL
# Do NOT use local 127.0.0.1 / trading_dev for normal development.
#
# Precedence: values in this `.env` file override stale shell exports.
# =============================================================================
DATABASE_URL=

# Supabase project (placeholders — do not commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Alpaca credentials (READ paths only) — placeholders only.
# ALPACA MARKET DATA ACCESS DOES NOT ENABLE ALPACA ORDER EXECUTION.
# CONNECTING AN ALPACA ACCOUNT DOES NOT AUTHORIZE TRADING.
# Never commit real keys. Never log these values.
# =============================================================================
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Paper trading API only — live api.alpaca.markets is forbidden by application code.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_TIMEOUT_SECONDS=10
MARKET_DATA_TIMEOUT_SECONDS=5
MARKET_DATA_QUOTE_MAX_AGE_SECONDS=30
MARKET_DATA_TRADE_MAX_AGE_SECONDS=60

# Trading day timezone for daily realized P&L
TRADING_DAY_TIMEZONE=America/New_York
